# ===========================对话补全配置================================
# 代理 API 密钥
MY_API_KEY=
# 上游 API 配置
UPSTREAM_API_KEY=
# 对话补全接口地址
UPSTREAM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 对话补全允许的模型列表（半角逗号分割）
ALLOWED_MODELS=glm-5v-turbo,glm-4.7-flash,glm-4.7-flashx,glm-4.6v-flash
# 对话补全启用深度思考
ENABLE_THINKING=0
# ===========================知识库配置==================================
# 注意：开启知识库时自动使用知识库接口
# 是否启用知识库
KNOWLEDGE_ENABLED=0
# 知识库接口地址
KNOWLEDGE_BASE_URL=https://open.bigmodel.cn/api/zrag/agent
# 知识库 API Key
KNOWLEDGE_API_KEY=
# 知识库 ID（半角逗号分割）
KNOWLEDGE_BASE_IDS=
# 知识库模型
KNOWLEDGE_MODEL=glm-5v-turbo
# 知识库启用深度思考
KNOWLEDGE_ENABLE_THINKING=0
# 知识库初筛召回数量
KNOWLEDGE_TOP_K=5
# 知识库精排最终数量
KNOWLEDGE_TOP_N=5
# 知识库是否启用重排序
KNOWLEDGE_ENABLE_RERANK=1
